# Compario Auth Server — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/compario
# Atlas (cloud):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/compario

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email (Gmail with App Password)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
# To get Gmail App Password:
# 1. Go to myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords → Generate one for "Mail"
# 4. Use that 16-char password here (NOT your Gmail password)
